GROWTH_AGENT_DATABASE_URL=postgresql://growth_agent_ro:CHANGEME@db:5432/datalayer
# Fallback-only, comma-separated, case-insensitive founder/team emails to
# exclude from every customer-facing metric (signups, uploads, activation,
# paid/free counts, lead outreach). The PRIMARY exclusion mechanism is the
# app's own users.is_admin/is_super_admin flags and needs no config here -
# this env var only matters for a founder/team member who used a free tool
# with their own email but never created a DataLayer account (csv_tool_leads
# has no role column to check). Leave empty unless that case actually applies.
GROWTH_AGENT_INTERNAL_EMAILS=
OPENROUTER_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
GROWTH_BRIEF_RECIPIENT=
BRIEF_SEND_HOUR_UTC=8
# Daily customer acquisition report (separate email, own LLM call) - sends
# to the same GROWTH_BRIEF_RECIPIENT. Defaults to the same hour as the
# growth brief but fires at :30 past it, not :00, so the two OpenRouter
# calls don't race each other.
ACQUISITION_REPORT_SEND_HOUR_UTC=8
# Weekly deterministic rollup report (separate email, no LLM call) - day of
# week (mon/tue/.../sun) and hour it sends, both UTC.
WEEKLY_REPORT_SEND_DAY_UTC=mon
WEEKLY_REPORT_SEND_HOUR_UTC=9
# Name of datalayer-ecommerce's Docker network - varies per host if that
# repo's checkout directory name differs. Confirm with:
#   docker network ls | grep datalayer
GROWTH_AGENT_NETWORK=datalayer-ecommerce_default

# GA4 Data API + Search Console API - see README section "Google Analytics /
# Search Console setup" for the full click-by-click Google Cloud Console steps.
# OAuth client (NOT a service account - usedatalayer.com's Workspace org
# blocks service-account key downloads) - from the OAuth Client ID created in
# step 4. Same three values work on EVERY host (unlike a key file, this isn't
# per-host) - GOOGLE_OAUTH_REFRESH_TOKEN comes from running
# scripts/authorize_google.py once, locally, with a browser.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Numeric GA4 Property ID from GA4 Admin > Property Settings - NOT the
# G-XXXXXXX measurement ID used in the site's tracking snippet.
GA4_PROPERTY_ID=
# Exact Search Console property identifier, confirmed from the Search Console
# UI: either "sc-domain:usedatalayer.com" (domain property) or
# "https://usedatalayer.com/" (URL-prefix property, trailing slash included).
SEARCH_CONSOLE_SITE_URL=

# Reddit API - read-only application-only OAuth (no Reddit account password
# needed). Create a "script" type app at https://www.reddit.com/prefs/apps
# to get the client ID/secret. See README section "Reddit API setup" for
# details. REDDIT_USER_AGENT should follow Reddit's recommended format:
# "server:datalayer-growth-agent:v1.0 (by /u/<your-reddit-username>)"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# Apify - powers the customer acquisition report's PROSPECTING section (real,
# live Shopify storefronts via the "Shopify Store Finder" Actor,
# igolaizola/shopify-store-finder). Get a token from Apify Console >
# Settings > Integrations. Optional - if unset, prospecting degrades
# gracefully (see data_gaps) and the report still sends without it.
APIFY_API_TOKEN=
# Niche/keyword filter passed to the Actor (e.g. "organic skincare") - leave
# empty for broad discovery across all niches.
APIFY_PROSPECT_QUERY=

# Action/experiment tracking - a SEPARATE, write-scoped role/connection from
# GROWTH_AGENT_DATABASE_URL above (which stays read-only). See README section
# "Create the tracking role + table" for the one-time SQL setup. Optional -
# if unset, tracking degrades gracefully (see data_gaps) and the daily brief
# still sends normally.
GROWTH_AGENT_TRACKING_DATABASE_URL=postgresql://growth_agent_tracking:CHANGEME@db:5432/datalayer
